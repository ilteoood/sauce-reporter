{
  "name": "sauce-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monthly open source activity report for the authenticated GitHub user.",
  "scripts": {
    "report": "TZ=UTC node src/index.ts",
    "start": "TZ=UTC node src/index.ts",
    "build": "tsc",
    "lint": "TZ=UTC tsc --noEmit",
    "typecheck": "TZ=UTC tsc --noEmit",
    "test": "TZ=UTC node --test src/**/*.test.ts",
    "test:watch": "TZ=UTC node --test --watch src/**/*.test.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/graphql": "^9.0.4",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
