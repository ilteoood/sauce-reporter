{
  "name": "sauce-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monthly open source activity report for the authenticated GitHub user.",
  "scripts": {
    "report": "TZ=UTC tsx src/index.ts",
    "start": "TZ=UTC tsx src/index.ts",
    "build": "tsc",
    "lint": "TZ=UTC tsc --noEmit",
    "typecheck": "TZ=UTC tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@octokit/graphql": "^9.0.0",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@actions/http-client": "^3.0.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
